    {
      "id": "filesystem_cat_read_dev",
      "family": "filesystem",
      "intent": "correct_tool_and_argv",
      "description": "Read repo file via cat — classify read, dev-local allows",
      "executable": "cat",
      "args": ["README.md"],
      "permission_profile": "dev-local",
      "role": "DEV",
      "expected": {
        "tool_id": "filesystem",
        "action_class": "read",
        "domain": "filesystem",
        "decision": "allow"
      }
    },
