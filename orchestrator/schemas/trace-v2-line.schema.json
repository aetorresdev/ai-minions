{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local.example/schemas/trace-v2-line.json",
  "title": "Orchestrator trace JSONL line (schema version 2)",
  "type": "object",
  "required": ["ts", "ts_ms", "trace_schema_version", "task_id", "event"],
  "properties": {
    "ts": { "type": "string", "format": "date-time" },
    "ts_ms": { "type": "integer" },
    "trace_schema_version": { "type": "string", "enum": ["2"] },
    "task_id": { "type": "string", "minLength": 1 },
    "event": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "event": { "const": "iteration_done" } },
        "required": ["event"]
      },
      "then": {
        "required": ["iteration", "outcome", "transition_reason"],
        "properties": {
          "iteration": { "type": "integer", "minimum": 0 },
          "outcome": { "type": "string" },
          "transition_reason": {
            "type": "object",
            "required": ["type", "reason_code"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "DONE",
                  "VALIDATION_FAIL",
                  "GATE_BLOCK",
                  "MAX_ITERATIONS",
                  "CONTRACT_FAIL",
                  "ITERATE_FALLBACK",
                  "ITERATE",
                  "GUARD"
                ]
              },
              "reason_code": {
                "type": "string",
                "enum": [
                  "RUN_COMPLETED",
                  "CERBERUS_BLOCKERS_ITERATE",
                  "ORCHESTRATOR_NO_CORRECTIONS_JSON",
                  "MAX_ITERATIONS_CERBERUS_BLOCKERS",
                  "GATE_ARTIFACT_OR_HANDOFF",
                  "MAX_ITERATIONS_GATE_BLOCKED_ARTIFACTS",
                  "ORCHESTRATOR_DECIDE_CORRECTIONS",
                  "CONTRACT_OR_DECIDE_FAILURE",
                  "VALIDATION_FAILURE_GENERIC",
                  "GUARD_COST_LIMIT",
                  "GUARD_STEP_RETRY_LIMIT",
                  "MAX_ITERATIONS_LOOP_EXHAUSTED"
                ]
              },
              "details": { "type": "string", "maxLength": 300 },
              "gate_id": { "type": "string", "maxLength": 120 },
              "step_id": { "type": "string", "maxLength": 240 }
            }
          },
          "failure_axis": {
            "type": "string",
            "enum": [
              "guard",
              "cerberus",
              "gate_artifact",
              "gate_tool",
              "orchestrate",
              "loop_cap",
              "contract",
              "unknown"
            ]
          },
          "intent_ids": {
            "type": "array",
            "maxItems": 48,
            "items": { "type": "string", "minLength": 8, "maxLength": 64 }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          { "properties": { "event": { "const": "iteration_done" } }, "required": ["event"] },
          { "not": { "properties": { "outcome": { "const": "done" } }, "required": ["outcome"] } }
        ]
      },
      "then": {
        "required": ["failure_type"],
        "properties": {
          "failure_type": {
            "type": "string",
            "enum": [
              "spec_missing",
              "contract_mismatch",
              "hallucination",
              "tool_error",
              "timeout",
              "cost_abort",
              "retry_exceeded"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "permission_check" } },
        "required": ["event"]
      },
      "then": {
        "required": [
          "actor",
          "role",
          "tool",
          "domain",
          "action_class",
          "target_class",
          "decision",
          "reason_code",
          "policy_source",
          "permission_profile",
          "requires_approval"
        ],
        "properties": {
          "actor": { "type": "string", "maxLength": 128 },
          "role": { "type": "string", "maxLength": 64 },
          "tool": { "type": "string", "maxLength": 512 },
          "domain": { "type": "string", "maxLength": 64 },
          "action_class": { "type": "string", "maxLength": 96 },
          "target_class": {
            "type": ["string", "null"],
            "maxLength": 96
          },
          "decision": {
            "type": "string",
            "enum": ["allow", "deny", "requires_approval"]
          },
          "reason_code": { "type": "string", "maxLength": 160 },
          "policy_source": { "type": "string", "maxLength": 160 },
          "permission_profile": { "type": "string", "minLength": 1, "maxLength": 64 },
          "requires_approval": { "type": "boolean" }
        }
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "credential_broker_used" } },
        "required": ["event"]
      },
      "then": {
        "required": [
          "credential_alias",
          "operation_class",
          "operation_kind",
          "decision",
          "reason_code",
          "agent_id",
          "effective_mode"
        ],
        "properties": {
          "credential_alias": { "type": "string", "minLength": 1, "maxLength": 128 },
          "operation_class": { "type": "string", "minLength": 1, "maxLength": 64 },
          "operation_kind": {
            "type": "string",
            "enum": ["read", "write", "unknown"]
          },
          "decision": { "type": "string", "enum": ["allow", "deny"] },
          "reason_code": { "type": "string", "minLength": 1, "maxLength": 160 },
          "agent_id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "effective_mode": {
            "type": "string",
            "enum": ["none", "read", "write"]
          },
          "target": { "type": "string", "maxLength": 200 }
        }
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "approval_required" } },
        "required": ["event"]
      },
      "then": {
        "required": [
          "agent",
          "iteration",
          "approval_id",
          "gate_id",
          "reason",
          "action_summary",
          "role"
        ],
        "properties": {
          "agent": { "type": "string", "minLength": 1, "maxLength": 128 },
          "iteration": { "type": "integer", "minimum": 0 },
          "approval_id": { "type": "string", "minLength": 8, "maxLength": 64 },
          "gate_id": { "type": "string", "const": "governance_human" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 300 },
          "action_summary": { "type": "string", "minLength": 1, "maxLength": 300 },
          "role": { "type": "string", "minLength": 1, "maxLength": 64 },
          "step_id": { "type": "string", "maxLength": 240 },
          "action_class": { "type": "string", "maxLength": 96 },
          "target_class": {
            "type": ["string", "null"],
            "maxLength": 96
          },
          "source_role": { "type": "string", "maxLength": 64 },
          "target_role": { "type": "string", "maxLength": 64 },
          "ownership_change": { "type": "boolean" },
          "handoff_contract_ref": { "type": "string", "maxLength": 200 },
          "related_permission_check": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tool": { "type": "string", "maxLength": 512 },
              "domain": { "type": "string", "maxLength": 64 },
              "decision": {
                "type": "string",
                "enum": ["allow", "deny", "requires_approval"]
              },
              "reason_code": { "type": "string", "maxLength": 160 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "approval_granted" } },
        "required": ["event"]
      },
      "then": {
        "required": ["agent", "iteration", "approval_id", "gate_id"],
        "properties": {
          "agent": { "type": "string", "minLength": 1, "maxLength": 128 },
          "iteration": { "type": "integer", "minimum": 0 },
          "approval_id": { "type": "string", "minLength": 8, "maxLength": 64 },
          "gate_id": { "type": "string", "const": "governance_human" },
          "step_id": { "type": "string", "maxLength": 240 },
          "notes": { "type": "string", "maxLength": 300 }
        }
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "approval_denied" } },
        "required": ["event"]
      },
      "then": {
        "required": ["agent", "iteration", "approval_id", "gate_id", "reason_code"],
        "properties": {
          "agent": { "type": "string", "minLength": 1, "maxLength": 128 },
          "iteration": { "type": "integer", "minimum": 0 },
          "approval_id": { "type": "string", "minLength": 8, "maxLength": 64 },
          "gate_id": { "type": "string", "const": "governance_human" },
          "reason_code": {
            "type": "string",
            "enum": [
              "GOVERNANCE_OPERATOR_DENIED",
              "GOVERNANCE_TIMEOUT",
              "GOVERNANCE_POLICY_MISMATCH"
            ]
          },
          "step_id": { "type": "string", "maxLength": 240 },
          "details": { "type": "string", "maxLength": 300 }
        }
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "production_boundary_check" } },
        "required": ["event"]
      },
      "then": {
        "required": [
          "check_schema_version",
          "mode",
          "protected_status",
          "permission_visibility",
          "decision",
          "evidence_refs",
          "gate_id"
        ],
        "properties": {
          "check_schema_version": { "type": "string", "enum": ["1"] },
          "mode": { "type": "string", "enum": ["agent_as_contributor"] },
          "repository": { "type": ["string", "null"], "maxLength": 200 },
          "pr_number": { "type": ["integer", "null"], "minimum": 0 },
          "source_branch": { "type": ["string", "null"], "maxLength": 200 },
          "target_branch": { "type": ["string", "null"], "maxLength": 200 },
          "default_branch": { "type": ["string", "null"], "maxLength": 200 },
          "protected_status": {
            "type": "string",
            "enum": ["known", "unknown", "not_protected"]
          },
          "rulesets_visible": { "type": "boolean" },
          "required_checks_visible": { "type": "boolean" },
          "required_reviews_visible": { "type": "boolean" },
          "actor_class": { "type": "string", "maxLength": 64 },
          "permission_visibility": {
            "type": "string",
            "enum": ["full", "limited", "unknown"]
          },
          "direct_merge_allowed": { "type": ["boolean", "null"] },
          "direct_push_protected_allowed": { "type": ["boolean", "null"] },
          "tag_create_allowed": { "type": ["boolean", "null"] },
          "release_publish_allowed": { "type": ["boolean", "null"] },
          "decision": {
            "type": "string",
            "enum": [
              "ready_for_human_review",
              "blocked",
              "requires_manual_policy_input"
            ]
          },
          "reason_code": { "type": ["string", "null"], "maxLength": 160 },
          "evidence_refs": {
            "type": "array",
            "maxItems": 16,
            "items": { "type": "string", "maxLength": 240 }
          },
          "gate_id": { "type": "string", "const": "pr_boundary_governance" },
          "workflow_state": { "type": ["string", "null"], "maxLength": 96 },
          "attempted_action": { "type": ["string", "null"], "maxLength": 64 },
          "agent": { "type": "string", "minLength": 1, "maxLength": 128 },
          "iteration": { "type": "integer", "minimum": 0 },
          "step_id": { "type": "string", "maxLength": 240 },
          "review_evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cerberus_verdict": {
                "type": ["string", "null"],
                "enum": ["approve", "request_changes", "block", null]
              },
              "qa_verdict": {
                "type": ["string", "null"],
                "enum": ["approve", "request_changes", "block", null]
              },
              "final_verdict": {
                "type": ["string", "null"],
                "enum": ["approve", "request_changes", "block", null]
              },
              "open_blocker_count": { "type": "integer", "minimum": 0, "maximum": 8 },
              "open_blockers": {
                "type": "array",
                "maxItems": 8,
                "items": { "type": "string", "maxLength": 300 }
              },
              "review_record_count": { "type": "integer", "minimum": 0, "maximum": 16 },
              "has_cerberus_record": { "type": "boolean" },
              "has_qa_record": { "type": "boolean" },
              "browser_verification_pending": { "type": "boolean" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "approval_skipped" } },
        "required": ["event"]
      },
      "then": {
        "required": [
          "agent",
          "iteration",
          "gate_id",
          "policy_mode",
          "reason_code",
          "approval_id"
        ],
        "properties": {
          "agent": { "type": "string", "minLength": 1, "maxLength": 128 },
          "iteration": { "type": "integer", "minimum": 0 },
          "gate_id": {
            "type": "string",
            "enum": ["product_scope", "architecture_plan", "dev_execution"]
          },
          "policy_mode": {
            "type": "string",
            "enum": ["required", "risk_based", "preview_only", "auto"]
          },
          "reason_code": {
            "type": "string",
            "enum": [
              "POLICY_EPIC_LOW_RISK",
              "POLICY_VALIDATION_ONLY",
              "POLICY_PREVIEW_ACKNOWLEDGED",
              "POLICY_AUTO_MODE"
            ]
          },
          "approval_id": { "type": "string", "minLength": 8, "maxLength": 64 },
          "step_id": { "type": "string", "maxLength": 240 },
          "risk_level": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "artifact_refs": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "string", "maxLength": 200 }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "context_hygiene_signal" } },
        "required": ["event"]
      },
      "then": {
        "required": ["agent", "active_role", "signal_id", "severity", "suggestion"],
        "properties": {
          "agent": { "type": "string", "minLength": 1, "maxLength": 128 },
          "active_role": { "type": "string", "minLength": 1, "maxLength": 128 },
          "signal_id": {
            "type": "string",
            "enum": [
              "context_growth_rate",
              "repeated_large_input_detected",
              "compaction_recommended",
              "fresh_run_recommended"
            ]
          },
          "severity": { "type": "string", "enum": ["info", "warn"] },
          "suggestion": { "type": "string", "minLength": 1, "maxLength": 300 },
          "metrics": {
            "type": "object",
            "additionalProperties": { "type": "number" }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "review_record" } },
        "required": ["event"]
      },
      "then": {
        "required": [
          "review_schema_version",
          "reviewer_role",
          "verdict",
          "blockers",
          "non_blocking_notes",
          "evidence_refs",
          "reviewed_artifact_ids",
          "iteration"
        ],
        "properties": {
          "review_schema_version": { "type": "string", "enum": ["1"] },
          "reviewer_role": { "type": "string", "enum": ["qa", "cerberus"] },
          "verdict": { "type": "string", "enum": ["approve", "request_changes", "block"] },
          "blockers": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "string", "maxLength": 300 }
          },
          "non_blocking_notes": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "string", "maxLength": 300 }
          },
          "evidence_refs": {
            "type": "array",
            "maxItems": 16,
            "items": { "type": "string", "maxLength": 240 }
          },
          "reviewed_artifact_ids": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "string", "maxLength": 240 }
          },
          "iteration": { "type": "integer", "minimum": 0 },
          "qa_verification_level": {
            "type": "string",
            "enum": ["static_pass_browser_pending", "browser_verified"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "doubt_review_started" } },
        "required": ["event"]
      },
      "then": {
        "required": [
          "doubt_review_schema_version",
          "agent",
          "iteration",
          "review_id",
          "claim_count"
        ],
        "properties": {
          "doubt_review_schema_version": { "type": "string", "enum": ["1"] },
          "agent": { "type": "string", "minLength": 1, "maxLength": 128 },
          "iteration": { "type": "integer", "minimum": 0 },
          "review_id": { "type": "string", "minLength": 8, "maxLength": 64 },
          "claim_count": { "type": "integer", "minimum": 0 },
          "step_id": { "type": "string", "maxLength": 240 }
        }
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "doubt_review_finding" } },
        "required": ["event"]
      },
      "then": {
        "required": [
          "doubt_review_schema_version",
          "review_id",
          "claim_id",
          "claim_category",
          "claim_summary",
          "finding_kind",
          "evidence_required",
          "iteration"
        ],
        "properties": {
          "doubt_review_schema_version": { "type": "string", "enum": ["1"] },
          "review_id": { "type": "string", "minLength": 8, "maxLength": 64 },
          "claim_id": { "type": "string", "minLength": 8, "maxLength": 64 },
          "claim_category": {
            "type": "string",
            "enum": [
              "runtime_contract",
              "release_claim",
              "security_posture",
              "docs_positioning",
              "handoff_authority",
              "lint_only"
            ]
          },
          "claim_summary": { "type": "string", "minLength": 1, "maxLength": 300 },
          "finding_kind": {
            "type": "string",
            "enum": [
              "blocker",
              "improvement",
              "nice_to_have",
              "overclaim_risk",
              "evidence_gap"
            ]
          },
          "evidence_required": { "type": "boolean" },
          "iteration": { "type": "integer", "minimum": 0 },
          "evidence_refs": {
            "type": "array",
            "maxItems": 16,
            "items": { "type": "string", "maxLength": 240 }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "doubt_review_verdict" } },
        "required": ["event"]
      },
      "then": {
        "required": [
          "doubt_review_schema_version",
          "review_id",
          "verdict",
          "finding_count",
          "iteration"
        ],
        "properties": {
          "doubt_review_schema_version": { "type": "string", "enum": ["1"] },
          "review_id": { "type": "string", "minLength": 8, "maxLength": 64 },
          "verdict": {
            "type": "string",
            "enum": ["approve", "request_changes", "block"]
          },
          "finding_count": { "type": "integer", "minimum": 0 },
          "iteration": { "type": "integer", "minimum": 0 },
          "notes": { "type": "string", "maxLength": 300 }
        }
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "recovery_detected" } },
        "required": ["event"]
      },
      "then": {
        "required": [
          "recovery_schema_version",
          "finding_kind",
          "severity",
          "description",
          "blocks_auto_recovery"
        ],
        "properties": {
          "recovery_schema_version": { "type": "string", "enum": ["1"] },
          "finding_kind": {
            "type": "string",
            "enum": [
              "missing_session_end",
              "stranded_step",
              "unresolved_ownership_handoff",
              "pending_governance_approval",
              "no_agent_steps"
            ]
          },
          "severity": { "type": "string", "enum": ["info", "warn", "error"] },
          "description": { "type": "string", "minLength": 1, "maxLength": 300 },
          "blocks_auto_recovery": { "type": "boolean" },
          "step_id": { "type": "string", "maxLength": 240 },
          "agent": { "type": "string", "maxLength": 128 },
          "iteration": { "type": "integer", "minimum": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "recovery_blocked" } },
        "required": ["event"]
      },
      "then": {
        "required": [
          "recovery_schema_version",
          "policy",
          "reason",
          "finding_count"
        ],
        "properties": {
          "recovery_schema_version": { "type": "string", "enum": ["1"] },
          "policy": { "type": "string", "enum": ["no_auto_retry"] },
          "reason": { "type": "string", "minLength": 1, "maxLength": 300 },
          "finding_count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "recovery_completed" } },
        "required": ["event"]
      },
      "then": {
        "required": [
          "recovery_schema_version",
          "policy",
          "finding_count",
          "clean",
          "summary"
        ],
        "properties": {
          "recovery_schema_version": { "type": "string", "enum": ["1"] },
          "policy": { "type": "string", "enum": ["no_auto_retry"] },
          "finding_count": { "type": "integer", "minimum": 0 },
          "clean": { "type": "boolean" },
          "summary": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": { "event": { "const": "session_end" } },
            "required": ["event"]
          },
          {
            "properties": {
              "permission_summary": { "type": "object" }
            },
            "required": ["permission_summary"]
          }
        ]
      },
      "then": {
        "properties": {
          "permission_summary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "permission_check_total",
              "by_decision",
              "reason_codes_top",
              "repeated_denials"
            ],
            "properties": {
              "permission_check_total": { "type": "integer", "minimum": 0 },
              "by_decision": {
                "type": "object",
                "additionalProperties": false,
                "required": ["allow", "deny", "requires_approval"],
                "properties": {
                  "allow": { "type": "integer", "minimum": 0 },
                  "deny": { "type": "integer", "minimum": 0 },
                  "requires_approval": { "type": "integer", "minimum": 0 }
                }
              },
              "reason_codes_top": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["reason_code", "count"],
                  "properties": {
                    "reason_code": { "type": "string", "maxLength": 160 },
                    "count": { "type": "integer", "minimum": 1 }
                  }
                }
              },
              "repeated_denials": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["fingerprint", "count", "tool", "domain", "reason_code"],
                  "properties": {
                    "fingerprint": { "type": "string", "maxLength": 640 },
                    "count": { "type": "integer", "minimum": 2 },
                    "tool": { "type": "string", "maxLength": 512 },
                    "domain": { "type": "string", "maxLength": 64 },
                    "reason_code": { "type": "string", "maxLength": 160 }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "session_checkpoint_created" } },
        "required": ["event"]
      },
      "then": {
        "required": [
          "session_resume_schema_version",
          "task_id",
          "eligible",
          "block_codes",
          "summary"
        ],
        "properties": {
          "session_resume_schema_version": { "type": "string", "enum": ["1"] },
          "task_id": { "type": "string", "minLength": 1 },
          "block_codes": {
            "type": "array",
            "maxItems": 16,
            "items": { "type": "string", "minLength": 1, "maxLength": 64 }
          },
          "summary": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "session_resume_requested" } },
        "required": ["event"]
      },
      "then": {
        "required": ["session_resume_schema_version", "task_id", "resume_of_task_id"],
        "properties": {
          "session_resume_schema_version": { "type": "string", "enum": ["1"] },
          "task_id": { "type": "string", "minLength": 1 },
          "resume_of_task_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "session_resume_loaded" } },
        "required": ["event"]
      },
      "then": {
        "required": ["session_resume_schema_version", "task_id", "resume_of_task_id"],
        "properties": {
          "session_resume_schema_version": { "type": "string", "enum": ["1"] },
          "task_id": { "type": "string", "minLength": 1 },
          "resume_of_task_id": { "type": "string", "minLength": 1 },
          "checkpoint_task_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "session_resume_blocked" } },
        "required": ["event"]
      },
      "then": {
        "required": [
          "session_resume_schema_version",
          "task_id",
          "block_codes",
          "summary"
        ],
        "properties": {
          "session_resume_schema_version": { "type": "string", "enum": ["1"] },
          "task_id": { "type": "string", "minLength": 1 },
          "resume_of_task_id": { "type": ["string", "null"] },
          "block_codes": {
            "type": "array",
            "maxItems": 16,
            "items": { "type": "string", "minLength": 1, "maxLength": 64 }
          },
          "summary": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "workspace_created" } },
        "required": ["event"]
      },
      "then": {
        "$ref": "#/$defs/workspaceLifecycleBase"
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "workspace_reused" } },
        "required": ["event"]
      },
      "then": {
        "$ref": "#/$defs/workspaceLifecycleBase"
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "workspace_rejected" } },
        "required": ["event"]
      },
      "then": {
        "allOf": [
          { "$ref": "#/$defs/workspaceLifecycleBase" },
          {
            "required": ["reason_code"],
            "properties": {
              "reason_code": { "type": "string", "minLength": 1, "maxLength": 64 }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "workspace_run_cwd_bound" } },
        "required": ["event"]
      },
      "then": {
        "allOf": [
          { "$ref": "#/$defs/workspaceLifecycleBase" },
          { "required": ["run_cwd"] }
        ]
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "workspace_artifacts_ready" } },
        "required": ["event"]
      },
      "then": {
        "allOf": [
          { "$ref": "#/$defs/workspaceLifecycleBase" },
          { "required": ["artifact_root"] }
        ]
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "workspace_promotion_started" } },
        "required": ["event"]
      },
      "then": {
        "allOf": [
          { "$ref": "#/$defs/workspaceLifecycleBase" },
          {
            "required": ["operator_approved"],
            "properties": {
              "operator_approved": { "type": "boolean" },
              "artifact_count": { "type": "integer", "minimum": 0, "maximum": 256 }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "workspace_promotion_completed" } },
        "required": ["event"]
      },
      "then": {
        "allOf": [
          { "$ref": "#/$defs/workspaceLifecycleBase" },
          {
            "required": ["operator_approved", "promoted_artifacts"],
            "properties": {
              "operator_approved": { "type": "boolean", "const": true },
              "promoted_artifacts": {
                "type": "array",
                "maxItems": 256,
                "items": {
                  "type": "object",
                  "required": ["source_rel", "dest_rel"],
                  "properties": {
                    "source_rel": { "type": "string", "minLength": 1, "maxLength": 512 },
                    "dest_rel": { "type": "string", "minLength": 1, "maxLength": 512 },
                    "promoted_at": { "type": "string", "minLength": 1, "maxLength": 40 }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "workspace_promotion_denied" } },
        "required": ["event"]
      },
      "then": {
        "allOf": [
          { "$ref": "#/$defs/workspaceLifecycleBase" },
          {
            "required": ["reason_code", "cleanup_side_effects"],
            "properties": {
              "reason_code": { "type": "string", "minLength": 1, "maxLength": 64 },
              "cleanup_side_effects": { "type": "boolean", "const": false }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "workspace_promotion_failed" } },
        "required": ["event"]
      },
      "then": {
        "allOf": [
          { "$ref": "#/$defs/workspaceLifecycleBase" },
          {
            "required": ["reason_code"],
            "properties": {
              "reason_code": { "type": "string", "minLength": 1, "maxLength": 64 },
              "detail": { "type": "string", "maxLength": 500 }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "workspace_cleanup_started" } },
        "required": ["event"]
      },
      "then": {
        "$ref": "#/$defs/workspaceLifecycleBase"
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "workspace_cleanup_completed" } },
        "required": ["event"]
      },
      "then": {
        "$ref": "#/$defs/workspaceLifecycleBase"
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "workspace_cleanup_skipped" } },
        "required": ["event"]
      },
      "then": {
        "allOf": [
          { "$ref": "#/$defs/workspaceLifecycleBase" },
          {
            "required": ["reason_code"],
            "properties": {
              "reason_code": { "type": "string", "minLength": 1, "maxLength": 64 }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "workspace_cleanup_failed" } },
        "required": ["event"]
      },
      "then": {
        "allOf": [
          { "$ref": "#/$defs/workspaceLifecycleBase" },
          {
            "required": ["reason_code", "retained"],
            "properties": {
              "reason_code": { "type": "string", "minLength": 1, "maxLength": 64 },
              "retained": { "type": "boolean" },
              "detail": { "type": "string", "maxLength": 500 }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "workspaceLifecycleBase": {
      "required": [
        "execution_actor",
        "isolation_mode",
        "worktree_path",
        "repo_root",
        "worktree_task_id"
      ],
      "properties": {
        "execution_actor": { "type": "string", "const": "workspace_manager" },
        "isolation_mode": { "type": "string", "const": "git_worktree" },
        "worktree_path": { "type": "string", "minLength": 1 },
        "repo_root": { "type": "string", "minLength": 1 },
        "worktree_task_id": { "type": "string", "minLength": 1 },
        "worktree_branch": { "type": "string", "minLength": 1 },
        "base_ref": { "type": "string", "minLength": 1 },
        "run_cwd": { "type": "string", "minLength": 1 },
        "artifact_root": { "type": "string", "minLength": 1 },
        "cleanup_policy": {
          "type": "string",
          "enum": ["retain", "cleanup_on_success", "cleanup_always"]
        }
      }
    }
  }
}
