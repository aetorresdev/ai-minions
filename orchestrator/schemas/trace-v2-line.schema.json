{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local.example/schemas/trace-v2-line.json",
  "title": "Orchestrator trace JSONL line (schema version 2)",
  "type": "object",
  "required": ["ts", "ts_ms", "trace_schema_version", "task_id", "event"],
  "properties": {
    "ts": { "type": "string", "format": "date-time" },
    "ts_ms": { "type": "integer" },
    "trace_schema_version": { "type": "string", "enum": ["2"] },
    "task_id": { "type": "string", "minLength": 1 },
    "event": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "event": { "const": "iteration_done" } },
        "required": ["event"]
      },
      "then": {
        "required": ["iteration", "outcome", "transition_reason"],
        "properties": {
          "iteration": { "type": "integer", "minimum": 0 },
          "outcome": { "type": "string" },
          "transition_reason": {
            "type": "object",
            "required": ["type", "reason_code"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "DONE",
                  "VALIDATION_FAIL",
                  "GATE_BLOCK",
                  "MAX_ITERATIONS",
                  "CONTRACT_FAIL",
                  "ITERATE_FALLBACK",
                  "ITERATE",
                  "GUARD"
                ]
              },
              "reason_code": {
                "type": "string",
                "enum": [
                  "RUN_COMPLETED",
                  "CERBERUS_BLOCKERS_ITERATE",
                  "ORCHESTRATOR_NO_CORRECTIONS_JSON",
                  "MAX_ITERATIONS_CERBERUS_BLOCKERS",
                  "GATE_ARTIFACT_OR_HANDOFF",
                  "MAX_ITERATIONS_GATE_BLOCKED_ARTIFACTS",
                  "ORCHESTRATOR_DECIDE_CORRECTIONS",
                  "CONTRACT_OR_DECIDE_FAILURE",
                  "VALIDATION_FAILURE_GENERIC",
                  "GUARD_COST_LIMIT",
                  "GUARD_STEP_RETRY_LIMIT",
                  "MAX_ITERATIONS_LOOP_EXHAUSTED"
                ]
              },
              "details": { "type": "string", "maxLength": 300 },
              "gate_id": { "type": "string", "maxLength": 120 },
              "step_id": { "type": "string", "maxLength": 240 }
            }
          },
          "failure_axis": {
            "type": "string",
            "enum": [
              "guard",
              "cerberus",
              "gate_artifact",
              "gate_tool",
              "orchestrate",
              "loop_cap",
              "contract",
              "unknown"
            ]
          },
          "intent_ids": {
            "type": "array",
            "maxItems": 48,
            "items": { "type": "string", "minLength": 8, "maxLength": 64 }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          { "properties": { "event": { "const": "iteration_done" } }, "required": ["event"] },
          { "not": { "properties": { "outcome": { "const": "done" } }, "required": ["outcome"] } }
        ]
      },
      "then": {
        "required": ["failure_type"],
        "properties": {
          "failure_type": {
            "type": "string",
            "enum": [
              "spec_missing",
              "contract_mismatch",
              "hallucination",
              "tool_error",
              "timeout",
              "cost_abort",
              "retry_exceeded"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "permission_check" } },
        "required": ["event"]
      },
      "then": {
        "required": [
          "actor",
          "role",
          "tool",
          "domain",
          "action_class",
          "target_class",
          "decision",
          "reason_code",
          "policy_source",
          "permission_profile",
          "requires_approval"
        ],
        "properties": {
          "actor": { "type": "string", "maxLength": 128 },
          "role": { "type": "string", "maxLength": 64 },
          "tool": { "type": "string", "maxLength": 512 },
          "domain": { "type": "string", "maxLength": 64 },
          "action_class": { "type": "string", "maxLength": 96 },
          "target_class": {
            "type": ["string", "null"],
            "maxLength": 96
          },
          "decision": {
            "type": "string",
            "enum": ["allow", "deny", "requires_approval"]
          },
          "reason_code": { "type": "string", "maxLength": 160 },
          "policy_source": { "type": "string", "maxLength": 160 },
          "permission_profile": { "type": "string", "minLength": 1, "maxLength": 64 },
          "requires_approval": { "type": "boolean" }
        }
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "approval_required" } },
        "required": ["event"]
      },
      "then": {
        "required": [
          "agent",
          "iteration",
          "approval_id",
          "gate_id",
          "reason",
          "action_summary",
          "role"
        ],
        "properties": {
          "agent": { "type": "string", "minLength": 1, "maxLength": 128 },
          "iteration": { "type": "integer", "minimum": 0 },
          "approval_id": { "type": "string", "minLength": 8, "maxLength": 64 },
          "gate_id": { "type": "string", "const": "governance_human" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 300 },
          "action_summary": { "type": "string", "minLength": 1, "maxLength": 300 },
          "role": { "type": "string", "minLength": 1, "maxLength": 64 },
          "step_id": { "type": "string", "maxLength": 240 },
          "action_class": { "type": "string", "maxLength": 96 },
          "target_class": {
            "type": ["string", "null"],
            "maxLength": 96
          },
          "source_role": { "type": "string", "maxLength": 64 },
          "target_role": { "type": "string", "maxLength": 64 },
          "ownership_change": { "type": "boolean" },
          "handoff_contract_ref": { "type": "string", "maxLength": 200 },
          "related_permission_check": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tool": { "type": "string", "maxLength": 512 },
              "domain": { "type": "string", "maxLength": 64 },
              "decision": {
                "type": "string",
                "enum": ["allow", "deny", "requires_approval"]
              },
              "reason_code": { "type": "string", "maxLength": 160 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "approval_granted" } },
        "required": ["event"]
      },
      "then": {
        "required": ["agent", "iteration", "approval_id", "gate_id"],
        "properties": {
          "agent": { "type": "string", "minLength": 1, "maxLength": 128 },
          "iteration": { "type": "integer", "minimum": 0 },
          "approval_id": { "type": "string", "minLength": 8, "maxLength": 64 },
          "gate_id": { "type": "string", "const": "governance_human" },
          "step_id": { "type": "string", "maxLength": 240 },
          "notes": { "type": "string", "maxLength": 300 }
        }
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "approval_denied" } },
        "required": ["event"]
      },
      "then": {
        "required": ["agent", "iteration", "approval_id", "gate_id", "reason_code"],
        "properties": {
          "agent": { "type": "string", "minLength": 1, "maxLength": 128 },
          "iteration": { "type": "integer", "minimum": 0 },
          "approval_id": { "type": "string", "minLength": 8, "maxLength": 64 },
          "gate_id": { "type": "string", "const": "governance_human" },
          "reason_code": {
            "type": "string",
            "enum": [
              "GOVERNANCE_OPERATOR_DENIED",
              "GOVERNANCE_TIMEOUT",
              "GOVERNANCE_POLICY_MISMATCH"
            ]
          },
          "step_id": { "type": "string", "maxLength": 240 },
          "details": { "type": "string", "maxLength": 300 }
        }
      }
    },
    {
      "if": {
        "properties": { "event": { "const": "context_hygiene_signal" } },
        "required": ["event"]
      },
      "then": {
        "required": ["agent", "active_role", "signal_id", "severity", "suggestion"],
        "properties": {
          "agent": { "type": "string", "minLength": 1, "maxLength": 128 },
          "active_role": { "type": "string", "minLength": 1, "maxLength": 128 },
          "signal_id": {
            "type": "string",
            "enum": [
              "context_growth_rate",
              "repeated_large_input_detected",
              "compaction_recommended",
              "fresh_run_recommended"
            ]
          },
          "severity": { "type": "string", "enum": ["info", "warn"] },
          "suggestion": { "type": "string", "minLength": 1, "maxLength": 300 },
          "metrics": {
            "type": "object",
            "additionalProperties": { "type": "number" }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": { "event": { "const": "session_end" } },
            "required": ["event"]
          },
          {
            "properties": {
              "permission_summary": { "type": "object" }
            },
            "required": ["permission_summary"]
          }
        ]
      },
      "then": {
        "properties": {
          "permission_summary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "permission_check_total",
              "by_decision",
              "reason_codes_top",
              "repeated_denials"
            ],
            "properties": {
              "permission_check_total": { "type": "integer", "minimum": 0 },
              "by_decision": {
                "type": "object",
                "additionalProperties": false,
                "required": ["allow", "deny", "requires_approval"],
                "properties": {
                  "allow": { "type": "integer", "minimum": 0 },
                  "deny": { "type": "integer", "minimum": 0 },
                  "requires_approval": { "type": "integer", "minimum": 0 }
                }
              },
              "reason_codes_top": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["reason_code", "count"],
                  "properties": {
                    "reason_code": { "type": "string", "maxLength": 160 },
                    "count": { "type": "integer", "minimum": 1 }
                  }
                }
              },
              "repeated_denials": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["fingerprint", "count", "tool", "domain", "reason_code"],
                  "properties": {
                    "fingerprint": { "type": "string", "maxLength": 640 },
                    "count": { "type": "integer", "minimum": 2 },
                    "tool": { "type": "string", "maxLength": 512 },
                    "domain": { "type": "string", "maxLength": 64 },
                    "reason_code": { "type": "string", "maxLength": 160 }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
