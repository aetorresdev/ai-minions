# ── Orchestrator example — environment variables ──────────────────────────────
# Copy to .env and adjust. None of these are required for basic usage.

# Timeout for claude CLI calls (ms). Default: 180000 (3 min)
# CLAUDE_CLI_TIMEOUT=180000

# ── Context compression between steps ─────────────────────────────────────────
# Set to "0" to disable Ollama handoff summaries between steps (use truncation only)
# AI_TEAM_STEP_SUMMARY=1

# Max chars of prior step output passed to the next agent (0 = no limit)
# AI_TEAM_MAX_CONTEXT_CHARS=12000

# Max chars of artifact output sent to Cerberus review (0 = no limit)
# AI_TEAM_MAX_REVIEW_CHARS_PER_ARTIFACT=0

# Ollama model used for handoff summaries. Default: qwen2.5-coder:7b
# AI_TEAM_SUMMARY_MODEL=qwen2.5-coder:7b

# Max chars of agent output sent to the Ollama summarizer. Default: 80000
# AI_TEAM_SUMMARIZE_MAX_INPUT_CHARS=80000

# Timeout for Ollama summary calls (ms). Default: 240000 (4 min)
# AI_TEAM_SUMMARY_TIMEOUT_MS=240000

# ── orchestrator-state MCP ─────────────────────────────────────────────────────
# Root directory for task state (envelope.json + events.jsonl per task_id)
# ORCHESTRATOR_STATE_ROOT=~/.claude/.state/orchestrator

# Ollama endpoint for goal alignment validation
# ORCHESTRATOR_OLLAMA_URL=http://localhost:11434/api/generate

# Ollama model for goal alignment validation
# ORCHESTRATOR_OLLAMA_MODEL=qwen2.5-coder:7b
