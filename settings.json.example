{
  "_comment": "Copy to ~/.claude/settings.json and replace ~/.claude with your actual home path if needed. Hook commands run as shell commands — ~ is expanded by the shell. Replace /path/to/your/context/ in SessionStart with your actual context directory. skill-registry-enforcer.py is wired under PreToolUse Skill but inactive until you export ORCH_SKILL_REGISTRY_ENFORCE=1 before starting Claude Code (see docs/orchestrator/skill-registry-contract.md).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "repo=$(basename \"$PWD\"); ctx=\"/path/to/your/context/CLAUDE_${repo}.md\"; if [ -f \"$ctx\" ]; then echo \"{\\\"hookSpecificOutput\\\": {\\\"hookEventName\\\": \\\"SessionStart\\\", \\\"additionalContext\\\": \\\"$(sed 's/\\\\/\\\\\\\\/g; s/\\\"/\\\\\\\"/g; s/$/\\\\n/g' \"$ctx\" | tr -d '\\n')\\\"}}\" ; fi",
            "statusMessage": "Loading project context..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/hooks/multi-agent-orchestrator.py",
            "statusMessage": "Checking for multi-agent orchestration..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/hooks/mem0-search.py",
            "statusMessage": "Searching memories..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/hooks/mode-enforcer.py",
            "statusMessage": "Enforcing MODE declaration..."
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_HOOK_EVENT=PreToolUse python3 ~/.claude/scripts/hooks/context-efficiency.py",
            "statusMessage": "Checking context efficiency..."
          }
        ]
      },
      {
        "matcher": "mcp__orchestrator-state__advance_mode",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_HOOK_EVENT=PreToolUse python3 ~/.claude/scripts/hooks/handoff-enforcer.py",
            "statusMessage": "Verifying compact_handoff before advance_mode..."
          },
          {
            "type": "command",
            "command": "CLAUDE_HOOK_EVENT=PreToolUse python3 ~/.claude/scripts/hooks/qa-skill-enforcer.py",
            "statusMessage": "Verifying QA skill before CERBERUS..."
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_HOOK_EVENT=PreToolUse python3 ~/.claude/scripts/hooks/skill-registry-enforcer.py",
            "statusMessage": "Checking skill registry allowlist..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__compact-handoff__compact_handoff",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_HOOK_EVENT=PostToolUse python3 ~/.claude/scripts/hooks/handoff-enforcer.py",
            "statusMessage": "Recording compact_handoff..."
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_HOOK_EVENT=PostToolUse python3 ~/.claude/scripts/hooks/qa-skill-enforcer.py",
            "statusMessage": "Recording QA skill usage..."
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/hooks/agent-metrics.py",
            "statusMessage": "Recording agent metrics..."
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/hooks/session-state.py",
            "statusMessage": "Updating session state..."
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/hooks/context-efficiency.py",
            "statusMessage": "Computing context efficiency..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/hooks/mem0-stop.sh",
            "statusMessage": "Checking mem0 for memory capture..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/hooks/flow-metrics.py",
            "statusMessage": "Computing flow metrics..."
          }
        ]
      }
    ]
  }
}
